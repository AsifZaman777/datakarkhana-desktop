{
  "name": "datakarkhana",
  "version": "2.0.1",
  "description": "DataKarkhana / MarketingOstad Desktop Application with Local Selenium Automation",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "desktop",
    "electron",
    "selenium",
    "scraper",
    "marketing",
    "datakarkhana"
  ],
  "author": "DataKarkhana",
  "license": "Commercial",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.datakarkhana.desktop",
    "productName": "DataKarkhana Desktop",
    "copyright": "Copyright © 2026 DataKarkhana",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "setup-dependencies.js",
      "package.json",
      "icon.*",
      "build/**/*",
      "!dist/**",
      "!**/.git/**"
    ],
    "extraResources": [
      {
        "from": "../datakarkhana-backend",
        "to": "datakarkhana-backend",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/__pycache__/**",
          "!**/scrape_results/**",
          "!**/uploads/**",
          "!**/logs/**",
          "!**/.env.example"
        ]
      },
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "icon": "build/icon.png",
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}